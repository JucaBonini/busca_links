---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dioup Busca — Portal Inteligente de Links & Produtividade</title>
    <meta name="description" content="Seu agregador moderno e rápido de links úteis, inteligência artificial, ferramentas de produtividade, streaming, notícias e esportes." />
    <meta name="theme-color" content="#6366f1" />

    <!-- Script de Inicialização Rápida de Tema para Evitar FOUC -->
    <script is:inline>
        (function() {
            const savedTheme = localStorage.getItem('dioup_theme');
            if (savedTheme === 'light') {
                document.documentElement.setAttribute('data-theme', 'light');
            }
        })();
    </script>

    <!-- FontAwesome 6 Pro/Free Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <meta name="generator" content={Astro.generator} />
</head>
<body>
    <Header />

    <!-- Barra de Navegação Rápida de Categorias -->
    <nav class="category-nav-wrapper" aria-label="Filtro de categorias">
        <button class="nav-tab-btn active" data-tab="all">
            <i class="fas fa-th-large"></i> Todos
        </button>
        {categories.map(cat => (
            <button class="nav-tab-btn" data-tab={cat.id}>
                <i class={cat.icon}></i> {cat.title}
            </button>
        ))}
    </nav>

    <!-- Conteúdo Principal com Grade Bento -->
    <main>
        <div class="categories-grid" id="main-grid">
            {categories.map(cat => (
                <CategoryCard 
                    id={cat.id}
                    title={cat.title} 
                    icon={cat.icon} 
                    links={cat.links} 
                />
            ))}
        </div>
    </main>

    <Footer />

    <script>
        // Sistema de Abas de Navegação Rápida
        const tabBtns = document.querySelectorAll('.nav-tab-btn');
        const cards = document.querySelectorAll('.category-card');

        tabBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                tabBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                const targetTab = btn.getAttribute('data-tab');

                cards.forEach(card => {
                    if (targetTab === 'all' || card.getAttribute('data-category') === targetTab) {
                        card.classList.remove('is-hidden');
                    } else {
                        card.classList.add('is-hidden');
                    }
                });
            });
        });
    </script>
</body>
</html>
