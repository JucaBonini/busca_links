---
---
<div class="info-bar">
    <!-- Relógio & Data -->
    <div class="info-card">
        <div class="info-icon time">
            <i class="fas fa-clock"></i>
        </div>
        <div class="info-content">
            <span class="info-label" id="data-atual">Carregando...</span>
            <span class="info-val" id="relogio"><span class="skeleton"></span></span>
        </div>
    </div>

    <!-- Clima & Localização -->
    <div class="info-card">
        <div class="info-icon weather" id="clima-icon">
            <i class="fas fa-cloud-sun"></i>
        </div>
        <div class="info-content">
            <span class="info-label" id="clima-cidade">Clima Local</span>
            <span class="info-val" id="temperatura"><span class="skeleton"></span></span>
        </div>
    </div>

    <!-- Cotação Dólar -->
    <div class="info-card">
        <div class="info-icon dollar">
            <i class="fas fa-dollar-sign"></i>
        </div>
        <div class="info-content">
            <span class="info-label">Dólar Comercial</span>
            <span class="info-val" id="cotacao-dolar"><span class="skeleton"></span></span>
        </div>
    </div>

    <!-- Cotação Bitcoin -->
    <div class="info-card">
        <div class="info-icon crypto">
            <i class="fab fa-bitcoin"></i>
        </div>
        <div class="info-content">
            <span class="info-label">Bitcoin</span>
            <span class="info-val" id="cotacao-bitcoin"><span class="skeleton"></span></span>
        </div>
    </div>
</div>

<script>
    // 1. Relógio e Data em tempo real
    function atualizarRelogioEData() {
        const agora = new Date();
        
        const relogioEl = document.getElementById('relogio');
        const dataEl = document.getElementById('data-atual');
        
        if (relogioEl) {
            relogioEl.textContent = agora.toLocaleTimeString('pt-BR', {
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                hour12: false
            });
        }
        
        if (dataEl) {
            const opcoesData: Intl.DateTimeFormatOptions = { 
                weekday: 'short', 
                day: '2-digit', 
                month: 'short' 
            };
            dataEl.textContent = agora.toLocaleDateString('pt-BR', opcoesData).toUpperCase();
        }
    }

    setInterval(atualizarRelogioEData, 1000);
    atualizarRelogioEData();

    // 2. Clima e Localização
    async function obterClimaLocal() {
        const tempEl = document.getElementById('temperatura');
        const cidadeEl = document.getElementById('clima-cidade');
        const iconContainer = document.getElementById('clima-icon');
        
        if (!tempEl || !cidadeEl) return;

        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                async (position) => {
                    try {
                        const lat = position.coords.latitude;
                        const lon = position.coords.longitude;

                        // Busca clima e geocodificação em paralelo
                        const [geoRes, weatherRes] = await Promise.all([
                            fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lon}&zoom=10`, {
                                headers: { 'User-Agent': 'DioupBusca/2.0' }
                            }).catch(() => null),
                            fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true`)
                        ]);

                        let cidade = "Sua Região";
                        if (geoRes && geoRes.ok) {
                            const geoData = await geoRes.json();
                            cidade = geoData.address.city || geoData.address.town || geoData.address.municipality || geoData.address.suburb || "Local";
                        }

                        if (weatherRes.ok) {
                            const weatherData = await weatherRes.json();
                            const temp = Math.round(weatherData.current_weather.temperature);
                            const weatherCode = weatherData.current_weather.weathercode;
                            
                            cidadeEl.textContent = cidade;
                            tempEl.textContent = `${temp}°C`;

                            // Ajuste do ícone baseado no código WMO
                            if (iconContainer) {
                                if (weatherCode === 0) iconContainer.innerHTML = '<i class="fas fa-sun"></i>';
                                else if (weatherCode <= 3) iconContainer.innerHTML = '<i class="fas fa-cloud-sun"></i>';
                                else if (weatherCode <= 67) iconContainer.innerHTML = '<i class="fas fa-cloud-rain"></i>';
                                else if (weatherCode <= 99) iconContainer.innerHTML = '<i class="fas fa-bolt"></i>';
                            }
                        }
                    } catch (error) {
                        cidadeEl.textContent = "Clima";
                        tempEl.textContent = "Indisponível";
                    }
                },
                () => {
                    cidadeEl.textContent = "Clima";
                    tempEl.textContent = "Ativar GPS";
                },
                { timeout: 8000 }
            );
        } else {
            cidadeEl.textContent = "Clima";
            tempEl.textContent = "Não suportado";
        }
    }

    obterClimaLocal();

    // 3. Cotações Financeiras (AwesomeAPI)
    async function obterCotacoes() {
        const dolarEl = document.getElementById('cotacao-dolar');
        const btcEl = document.getElementById('cotacao-bitcoin');

        try {
            const response = await fetch('https://economia.awesomeapi.com.br/json/last/USD-BRL,BTC-BRL');
            if (!response.ok) throw new Error('Falha na API');
            
            const data = await response.json();

            if (dolarEl && data.USDBRL) {
                const dolar = parseFloat(data.USDBRL.bid).toFixed(2);
                dolarEl.textContent = `R$ ${dolar.replace('.', ',')}`;
            }
            if (btcEl && data.BTCBRL) {
                const btcVal = parseFloat(data.BTCBRL.bid);
                btcEl.textContent = btcVal.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: 0 });
            }
        } catch (error) {
            if (dolarEl) dolarEl.textContent = "Indisponível";
            if (btcEl) btcEl.textContent = "Indisponível";
        }
    }

    obterCotacoes();
    setInterval(obterCotacoes, 180000); // 3 minutos
</script>
